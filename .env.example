NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Public application URL used in confirmation emails and server-generated links.
# Production example: https://leadhub-loan-crm.vercel.app
NEXT_PUBLIC_APP_HOST=
CAMPAIGN_BASE_URL=https://leadhub-loan-crm.vercel.app

# Server-only. Used for logo upload and local DB tests. Do not expose this to client code.
SUPABASE_SERVICE_ROLE_KEY=

# Server-only bearer secret used by the hourly follow-up reminder cron.
CRON_SECRET=

# Comma-separated founder/admin email addresses allowed to access /admin.
ADMIN_EMAILS=

# Server-only. Used by signup profile creation and local migration/test helpers.
# Do not expose this to client code.
# Example: postgres://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres
DATABASE_URL=

# Brevo SMTP credentials are used in two places:
# 1. Supabase Dashboard -> Authentication -> SMTP Settings for auth emails.
# 2. This app's server route for new lead notification emails.
# Never expose these in NEXT_PUBLIC_* variables.
BREVO_SMTP_HOST=smtp-relay.brevo.com
BREVO_SMTP_PORT=587
BREVO_SMTP_USERNAME=
BREVO_SMTP_PASSWORD=
BREVO_SMTP_SENDER_EMAIL=
BREVO_SMTP_SENDER_NAME=LeadHub

# Server-only. Used by founder admin campaigns through Brevo Transactional API.
BREVO_API_KEY=

# Server-only. Add this secret to the Brevo webhook URL as ?secret=...
BREVO_WEBHOOK_SECRET=

# Optional controlled test recipient for npm run test:brevo-send.
BREVO_TEST_EMAIL=

# Optional founder campaign template settings. All are server-only.
CAMPAIGN_SENDER_PHONE=7001586476
CAMPAIGN_SENDER_CONTACT_EMAIL=tamoghna171099@gmail.com
CAMPAIGN_BROCHURE_PATH=artifacts/LeadHub-Loan-Agent-Sales-Brochure.pdf
CAMPAIGN_ATTACH_BROCHURE=true

# Optional automation for `npm run configure:smtp`.
# Create this in Supabase Account -> Access Tokens.
SUPABASE_ACCESS_TOKEN=
# Optional; derived from NEXT_PUBLIC_SUPABASE_URL when omitted.
SUPABASE_PROJECT_REF=

CRON_SECRET=084ea11759bc48f25e631d893828f463fbd9c15ad5c4e0cef7025e3d6ad1b317
